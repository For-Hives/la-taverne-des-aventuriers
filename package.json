{
  "name": "la-taverne-des-aventuriers",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": "^12.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:ci": "node scripts/fake-pocketbase.mjs pnpm build",
    "build:instantane": "node scripts/instantane/avec-instantane.mjs next build",
    "start": "next start",
    "check": "biome check --write",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "tsc": "npx tsc --noEmit --watch",
    "test": "pnpm test:unit && node scripts/fake-pocketbase.mjs node scripts/smoke-test.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tests/alias.mjs --test \"scripts/tests/*.test.mjs\"",
    "test:e2e": "node scripts/fake-pocketbase.mjs node scripts/tests/e2e-plan-du-site.mjs",
    "test:navigateur": "playwright test",
    "test:visuel:docker": "bash scripts/visuel-docker.sh",
    "test:visuel:maj": "bash scripts/visuel-docker.sh --update-snapshots=all",
    "instantane:extraire": "node scripts/instantane/extraire-prod.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-common-types": "7.3.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@heroicons/react": "2.2.0",
    "@next/third-parties": "16.4.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@rive-app/canvas": "2.50.0",
    "@rive-app/react-canvas": "4.39.0",
    "@tailwindcss/typography": "0.5.20",
    "@vimeo/player": "2.30.4",
    "aos": "2.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.1",
    "lucide-react": "1.71.0",
    "motion": "14.11.1",
    "next": "16.4.6",
    "pocketbase": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
